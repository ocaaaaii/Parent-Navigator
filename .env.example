# ── JWT ───────────────────────────────────────────────
# 隨機產生 64 位元以上的字串：openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── SMS 提供商 ─────────────────────────────────────────
# 選填 "twilio" 或 "every8d"
SMS_PROVIDER=twilio

# Twilio（國際通用）
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX   # 購買的 Twilio 號碼

# 每日簡訊 Every8D（台灣，費用較低）
# https://www.every8d.com
EVERY8D_UID=your_uid
EVERY8D_PWD=your_password

# ── CORS ──────────────────────────────────────────────
# 正式部署後改為你的 Vercel 網域
ALLOWED_ORIGIN=https://your-project.vercel.app

