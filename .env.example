# ════════════════════════════════════════════════════════
# 育兒導航全攻略 — 環境變數範本
# 複製此檔案為 .env（本地開發）或填入 Vercel Environment Variables
# ⚠️  .env 已加入 .gitignore，絕對不要 commit 真實的密鑰！
# ════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key（不是 anon key）

# ── JWT ───────────────────────────────────────────────
# 隨機產生 64 位元以上的字串：openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── SMS 提供商 ─────────────────────────────────────────
# 選填 "twilio" 或 "every8d"
SMS_PROVIDER=twilio

# Twilio（國際通用）
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX   # 購買的 Twilio 號碼

# 每日簡訊 Every8D（台灣，費用較低）
# https://www.every8d.com
EVERY8D_UID=your_uid
EVERY8D_PWD=your_password

# ── CORS ──────────────────────────────────────────────
# 正式部署後改為你的 Vercel 網域
ALLOWED_ORIGIN=https://your-project.vercel.app

# ── AnythingLLM（Chatbot）─────────────────────────────
ANYTHINGLLM_BASE_URL=http://your-anythingllm-host:3001
ANYTHINGLLM_API_KEY=your-anythingllm-api-key
ANYTHINGLLM_WORKSPACE=your-workspace-slug
