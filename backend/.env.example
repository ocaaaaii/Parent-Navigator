# .env.example — 複製為 .env 並填入真實值
# 注意：.env 不要 commit 到 Git！已加入 .gitignore

# ── Flask ──────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=false
FLASK_PORT=5000

# ── LINE Bot ───────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ── Supabase / PostgreSQL ──────────────────────────────────────
# 格式：postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# 取自 Supabase Dashboard → Project Settings → Database → Connection string（Session mode）
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@...supabase.com:5432/postgres

# Supabase REST API（選用，目前後端直接用 psycopg2 不需要）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# 連線池大小（Render Free 建議 max=3，避免超出 Supabase 連線上限）
DB_POOL_MIN=1
DB_POOL_MAX=3

# ── OpenAI ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
EMBEDDING_MODEL=text-embedding-3-small

# ── RAG 查詢 ───────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35

# ── Wiki 資料夾 ────────────────────────────────────────────────
WIKI_DIR=../wiki

# ── 推播排程 ───────────────────────────────────────────────────
SCHEDULER_PUSH_HOUR=9
SCHEDULER_PUSH_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Taipei
