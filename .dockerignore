# ── 機密（不進 Docker image） ────────────────────────────────────
.env
.env.*
!.env.example

# ── Git ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Python 暫存 ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ── 本地 MySQL 資料（用 volume，不打包進 image） ─────────────────
my_mysql_data/
mysql_data/

# ── 向量資料庫（image 啟動後重建，不打包） ────────────────────────
chroma_db/

# ── 日誌 ─────────────────────────────────────────────────────────
logs/
*.log

# ── 簡報與暫存檔 ──────────────────────────────────────────────────
*.pptx
~$*
node_modules/

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
